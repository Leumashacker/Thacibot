# Copy this file to .env and fill it in.
# Numbers: country code + number, digits only, no "+" (Kenya example: 2547XXXXXXXX)

BOT_NAME=Thaci bot
PREFIX=.
OWNER_NAME=Your Name
OWNER_NUMBER=2547XXXXXXXX

# Number to link with a pairing code (usually the same as OWNER_NUMBER)
PAIRING_NUMBER=2547XXXXXXXX

# Hours before the away greeting is sent again to the same friend
AWAY_COOLDOWN_HOURS=6
